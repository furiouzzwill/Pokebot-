# Copy to .env and fill in. .env is gitignored.
#
# This project only *watches* product pages and notifies you. It never signs in,
# never carts, and never pays -- so it deliberately has no fields for account
# credentials, card numbers, or CAPTCHA-solver API keys.

# --- Polling -----------------------------------------------------------------
# Milliseconds between checks of a single product. Floor is 5000 (see config.js).
# 30-60s is plenty for a drop and keeps you well clear of rate limiting.
POLL_INTERVAL_MS=30000

# Random jitter added to each interval, in ms. Spreads requests out so every
# product isn't polled on the same tick.
POLL_JITTER_MS=5000

# Per-request timeout.
REQUEST_TIMEOUT_MS=15000

# Consecutive failures before a product is put in a cooldown backoff.
MAX_CONSECUTIVE_ERRORS=5

# --- Notifications -----------------------------------------------------------
# All optional. With none set you still get console + logfile output.

# Discord incoming webhook URL.
DISCORD_WEBHOOK_URL=

# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=

# Generic POST target. Receives the raw JSON event.
GENERIC_WEBHOOK_URL=

# Terminal bell on restock (1 to enable).
NOTIFY_BELL=1

# Re-notify every N minutes while an item stays in stock. 0 = notify once per
# out-of-stock -> in-stock transition only.
RENOTIFY_MINUTES=0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=1
