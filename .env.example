# Copy to .env and fill in. .env is gitignored.
#
# This project only *watches* product pages and notifies you. It never signs in,
# never carts, and never pays -- so it deliberately has no fields for account
# credentials, card numbers, or CAPTCHA-solver API keys.

# --- Polling -----------------------------------------------------------------
# Milliseconds between checks of a single product. Floor is 5000 (see config.js).
# 30-60s is plenty for a drop and keeps you well clear of rate limiting.
POLL_INTERVAL_MS=30000

# Random jitter added to each interval, in ms. Spreads requests out so every
# product isn't polled on the same tick.
POLL_JITTER_MS=5000

# Per-request timeout.
REQUEST_TIMEOUT_MS=15000

# Consecutive failures before a product is put in a cooldown backoff.
MAX_CONSECUTIVE_ERRORS=5

# --- Notifications -----------------------------------------------------------
# All optional. With none set you still get console + logfile output.

# Discord incoming webhook URL.
DISCORD_WEBHOOK_URL=

# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=

# Generic POST target. Receives the raw JSON event.
GENERIC_WEBHOOK_URL=

# Terminal bell on restock (1 to enable).
NOTIFY_BELL=1

# Re-notify every N minutes while an item stays in stock. 0 = notify once per
# out-of-stock -> in-stock transition only.
RENOTIFY_MINUTES=0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=1

# --- Discord -----------------------------------------------------------------
# All optional. Credentials live here rather than in config/app-state.json,
# because that file gets copied, backed up and pasted around far too easily.

# OUT: post alerts to a channel. Server Settings -> Integrations -> Webhooks
# -> New Webhook -> Copy Webhook URL. Anyone holding this URL can post to that
# channel, so treat it like a password.
DISCORD_WEBHOOK_URL=

# Prefix urgent alerts (in stock, carted, bot check) with a ping. Use @here,
# @everyone, or a role mention like <@&123456789>. Blank = never ping.
DISCORD_MENTION=

# IN: read drop links your group posts. Create a bot at
# https://discord.com/developers/applications -> Bot -> Reset Token, invite it
# to your server, and give it Read Messages + Read Message History on the
# channels below. Message Content intent is NOT needed for this (REST reads).
DISCORD_BOT_TOKEN=

# Channel ids to watch, comma separated. Enable Developer Mode in Discord
# (Settings -> Advanced), then right-click a channel -> Copy Channel ID.
DISCORD_CHANNEL_IDS=
