{
  "name": "pokebot",
  "version": "0.1.0",
  "description": "Stock monitor for Pokemon TCG drops at Walmart and Target. Alerts you when an item goes in stock so you can buy it yourself.",
  "main": "desktop/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js watch",
    "check": "node src/index.js check",
    "test": "node --test test/*.test.js",
    "test:extension": "node --test test/extension.test.js",
    "app": "node app/server.js",
    "dashboard": "node app/server.js",
    "desktop": "electron .",
    "build:desktop": "electron-builder",
    "build:all": "electron-builder -mwl"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pokebot.dashboard",
    "productName": "Pokebot",
    "files": [
      "desktop/**/*",
      "app/**/*",
      "src/**/*",
      "extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
